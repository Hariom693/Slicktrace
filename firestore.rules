rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function analyst() {
      return signedIn() && (role() == 'admin' || role() == 'analyst');
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'viewer';
      allow read: if signedIn() && (request.auth.uid == userId || analyst());
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /incidents/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /satelliteObservations/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /oilSpills/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /vessels/{document=**} {
      allow read: if signedIn();
      allow write: if analyst();
    }

    match /aisTracks/{document=**} {
      allow read: if signedIn();
      allow write: if analyst();
    }

    match /driftPredictions/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /attributions/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /timelineEvents/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /evidence/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /reports/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }

    match /notifications/{document=**} {
      allow read: if signedIn();
      allow create, update: if analyst();
      allow delete: if false;
    }
  }
}
